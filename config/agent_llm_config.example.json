{
  "llm": {
    "provider": "ollama",
    "model": "qwen2.5",
    "vision_model": null,
    "base_url": "http://localhost:11434",
    "temperature": 0.7,
    "top_p": 0.9,
    "num_ctx": 4096,
    "max_tokens": 4096,
    "timeout": 600,
    "keep_alive": -1
  },
  "agent": {
    "system_prompt": "你是一个基于本地模型运行的智能助手。请用中文友好、专业地回答用户问题。",
    "max_history": 40,
    "enable_tools": true
  },
  "server": {
    "host": "127.0.0.1",
    "port": 5000
  },
  "business": {
    "enabled": false,
    "base_url": "",
    "timeout": 8,
    "auth": {
      "scheme": "bearer",
      "token_env": "STORE_API_TOKEN"
    },
    "endpoints": {
      "stock": "/stock/{code}",
      "order": "/orders/{order_id}",
      "products": "/products"
    }
  }
}